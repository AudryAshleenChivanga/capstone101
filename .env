# H. pylori CDSS - Environment Variables

# DATABASE CONFIGURATION
DATABASE_URL=sqlite:///./cdss.db

# SECURITY CONFIGURATION
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML MODELS CONFIGURATION
SCREEN_MODEL_PATH=models/screening_hp_pos_calibrated.joblib
STAGE_MODEL_PATH=models/staging_3class.joblib
SCREEN_THRESH=0.5

# TWILIO SMS CONFIGURATION (Optional - can be left empty for now)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# EMAIL CONFIGURATION (Optional - can be left empty for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=H. pylori CDSS

# CORS CONFIGURATION
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# APPLICATION CONFIGURATION
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# SERVER CONFIGURATION
HOST=0.0.0.0
PORT=8000
WORKERS=4

