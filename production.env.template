# ==================================
# H. pylori CDSS - Production Environment Template
# ==================================
# For Oracle Cloud Deployment
# Copy this to .env on your Oracle instance

# ==================================
# DATABASE CONFIGURATION
# ==================================
DATABASE_URL=sqlite:///./cdss.db

# ==================================
# SECURITY CONFIGURATION (CHANGE THESE!)
# ==================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-32-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================================
# ML MODELS CONFIGURATION
# ==================================
SCREEN_MODEL_PATH=models/screening_hp_pos_calibrated.joblib
STAGE_MODEL_PATH=models/staging_3class.joblib
SCREEN_THRESH=0.5

